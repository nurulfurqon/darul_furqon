---
// src/pages/admin/berita/[id].astro
import AdminShell from '../../../layouts/AdminShell.astro';
---
<AdminShell title="Edit Berita" activePage="berita">
  <div class="mb-3"><a href="/admin/berita" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Kembali</a></div>
  <div class="card border-0 shadow-sm" style="max-width:760px">
    <div class="card-body">
      <div id="form-alert"></div>
      <form id="news-form">
        <div class="mb-3">
          <label class="form-label fw-semibold">Judul</label>
          <input type="text" name="title" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Thumbnail</label>
          <input type="file" id="thumbnail-file" class="form-control" accept="image/*" />
          <input type="hidden" name="thumbnailUrl" />
          <img id="thumbnail-preview" src="" class="mt-2 rounded d-none" style="height:160px;width:100%;object-fit:cover" />
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Konten</label>
          <textarea name="content" class="form-control" rows="10" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary" id="btn-save">Simpan Perubahan</button>
      </form>
    </div>
  </div>
</AdminShell>

<script>
  import { apiFetch, apiUpload } from '../../../lib/api';
  const id = new URLSearchParams(window.location.search).get('id');

  async function loadNews() {
    try {
      const data = await apiFetch<any>(`/api/v1/news/${id}`);
      const form = document.getElementById('news-form') as HTMLFormElement;
      if (!form) return;
      
      form.title.value = data.title;
      form.content.value = data.content;
      (form.querySelector('[name=thumbnailUrl]') as HTMLInputElement).value = data.thumbnailUrl ?? '';
      
      if (data.thumbnailUrl) {
        const preview = document.getElementById('thumbnail-preview') as HTMLImageElement;
        preview.src = data.thumbnailUrl;
        preview.classList.remove('d-none');
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.getElementById('thumbnail-file')?.addEventListener('change', async (e) => {
    const target = e.target as HTMLInputElement;
    const file = target.files?.[0];
    if (!file) return;
    try {
      const result = await apiUpload('news', file);
      (document.querySelector('[name=thumbnailUrl]') as HTMLInputElement).value = result.url;
      const preview = document.getElementById('thumbnail-preview') as HTMLImageElement;
      preview.src = result.url;
      preview.classList.remove('d-none');
    } catch (err) {
      alert('Gagal mengunggah gambar');
    }
  });

  document.getElementById('news-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = document.getElementById('btn-save') as HTMLButtonElement;
    btn.disabled = true;
    try {
      await apiFetch(`/api/v1/news/${id}`, {
        method: 'PUT',
        body: JSON.stringify({
          title: form.title.value,
          content: form.content.value,
          thumbnailUrl: (form.querySelector('[name=thumbnailUrl]') as HTMLInputElement).value || undefined,
        }),
      });
      window.location.href = '/admin/berita';
    } catch (err: any) {
      const alertEl = document.getElementById('form-alert');
      if (alertEl) alertEl.innerHTML = `<div class="alert alert-danger">${err.message}</div>`;
      btn.disabled = false;
    }
  });

  document.addEventListener('DOMContentLoaded', loadNews);
  loadNews();
</script>
